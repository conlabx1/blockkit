{
  "permissions": {
    "deny": [
      "Edit(/check)",
      "Edit(/tests/test_check.py)",
      "Edit(/.claude/settings.json)"
    ],
    "ask": [
      "Edit(/pyproject.toml)",
      "Edit(/uv.lock)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.venv/**)",
      "Edit(/blocks/**/CARD.md)",
      "Edit(/doors/**/CARD.md)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/check\" --hook",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
