{
  "permissions": {
    "deny": [
      "Edit(/check)",
      "Edit(/tools/check/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/rust-toolchain.toml)",
      "Edit(/rust-toolchain)",
      "Edit(/.cargo/**)",
      "Edit(/.codex/**)",
      "Edit(/.agents/hooks.json)"
    ],
    "ask": [
      "Edit(/Cargo.toml)",
      "Edit(/Cargo.lock)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/blocks/**/CARD.md)",
      "Edit(/doors/**/CARD.md)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/check\" --hook",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
