#!/usr/bin/env python3
"""블록 조립 규칙을 지켰는지 점검한다.

사용법: ./check          사람이 읽는 결과를 출력한다.
        ./check --hook   Claude Code 의 Stop 훅으로 쓴다(.claude/settings.json).

종료 코드: 0 전부 통과, 1 실패 있음(점검을 시작하지 못한 것도 실패다), 2 실패는 없지만 점검하지 못한 항목 있음.
"""
import os
import sys

# 프로젝트 폴더에 놓인 파일(subprocess.py 등)이 표준 모듈 대신 불려서 점검을 가로채지 못하게,
# 다른 모듈을 부르기 전에 이 파일이 놓인 폴더를 모듈 찾는 길에서 뺀다.
sys.path[:] = [entry for entry in sys.path if os.path.realpath(entry or ".") != os.path.dirname(os.path.realpath(__file__))]

import ast
import json
import re
import shutil
import subprocess
import unicodedata
from pathlib import Path

# 링크를 따라가지 않는다. check 가 다른 프로젝트의 것으로 걸린 링크여도, 링크가 놓인 프로젝트를 점검한다.
HERE = Path(os.path.abspath(__file__))
ROOT = HERE.parent
PASS, FAIL, SKIP = "✅", "❌", "⚠️"


def clean(text):
    """화면에 낼 글자에서 줄바꿈과 제어 문자를 물음표로 바꾼다. 파일 이름이나 카드 글자로 「결과:」 줄을 꾸며 낼 수 없게 한다."""
    kinds = ((char, unicodedata.category(char)) for char in str(text))
    return "".join("?" if kind in ("Cc", "Cf", "Cs", "Zl", "Zp") else char for char, kind in kinds)

# ---- 바깥쪽 ----
# 어떤 파이썬으로 불려도, 프로젝트가 고정한 파이썬과 의존성 안에서 점검을 다시 실행한다.
# 훅은 맥 기본 파이썬(3.9)으로 불릴 수 있으므로 이 파일의 문법은 3.9 에서 읽혀야 한다.


def find_uv():
    found = shutil.which("uv")
    if found:
        return found
    # 훅은 PATH 가 짧은 환경에서 돌 수 있어서 흔한 설치 위치를 직접 본다.
    for candidate in ("/opt/homebrew/bin/uv", "/usr/local/bin/uv", "~/.local/bin/uv", "~/.cargo/bin/uv"):
        path = os.path.expanduser(candidate)
        if os.access(path, os.X_OK):
            return path
    return None


def not_started(reason):
    # 점검이 통째로 돌지 못한 상태를 「점검 못 함」으로 두면 그사이의 실패가 가려진다. 그래서 실패로 본다.
    return 1, "%s 점검: 시작하지 못했습니다. %s\n\n결과: 실패 1개(점검을 시작하지 못했습니다)\n" % (FAIL, clean(reason))


def run_inside():
    """(종료 코드, 출력) 을 돌려준다."""
    uv = find_uv()
    if not uv:
        return not_started("uv 를 찾지 못했습니다.")
    # --locked: pyproject.toml 과 uv.lock 이 어긋나면 멈춘다. --exact: uv.lock 에 없는 부품을 가상 환경에서 지운다.
    # 그래서 pyproject.toml 에 적힌 부품과 그 부품이 끌고 오는 부품 말고는 깔려 있을 수 없다.
    command = [uv, "run", "--locked", "--exact", "--quiet", "--project", str(ROOT), "python", str(HERE), "--inside", uv]
    env = dict(os.environ, PYTHONUTF8="1")
    try:
        # 훅의 시간 한도(.claude/settings.json 의 300초)보다 먼저 스스로 끝나야 결과를 알릴 수 있다.
        done = subprocess.run(command, env=env, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=280)
    except subprocess.TimeoutExpired:
        return not_started("시간 안에 끝나지 않았습니다.")
    except OSError as error:  # 훅에서는 여기서 죽으면 막지도 알리지도 못한 채 지나간다.
        return not_started("uv 를 실행하지 못했습니다(%s)." % error)
    # 줄 머리의 「결과:」만 본다. 카드 설명 같은 다른 줄에 섞인 글자를 끝까지 돈 표시로 읽지 않는다.
    if not any(line.startswith("결과:") for line in done.stdout.splitlines()):
        if "--locked" in done.stderr:
            return not_started("pyproject.toml 과 uv.lock 이 서로 맞지 않습니다. 에이전트에게 「uv lock 으로 맞춰 줘」라고 말하면 됩니다.")
        return not_started((done.stderr.strip().splitlines() or ["알 수 없는 오류"])[-1].strip())
    return done.returncode, done.stdout


def main_outside(argv):
    sys.stdout.reconfigure(encoding="utf-8")
    if "--hook" not in argv:
        code, output = run_inside()
        sys.stdout.write(output)
        return code
    # 훅에서는 종료 코드 2 가 차단으로 읽힌다. 그래서 결과는 JSON 으로만 알리고 0 으로 끝낸다.
    try:
        data = json.load(sys.stdin)
    except ValueError:
        data = {}
    if not isinstance(data, dict):
        data = {}
    _, output = run_inside()
    verdict = next((line for line in output.splitlines() if line.startswith("결과:")), output.strip())
    # 매번 한 줄을 화면에 보여 준다. 이 줄이 안 보이면 훅이 돌지 않은 것이다.
    reply = {"systemMessage": "점검(./check) " + verdict}
    # 의존성 실패는 방금 고친 것과 무관하게 새 취약점 공개로 생길 수 있어서, 알리기만 하고 막지는 않는다.
    blocking = [line for line in output.splitlines() if line.startswith(FAIL) and not line.startswith(FAIL + " 의존성")]
    # 이미 한 번 막아서 이어 가는 중이면 다시 막지 않는다(끝없이 도는 것을 막는다). 실패 상태는 위 한 줄로 보인다.
    if blocking and not data.get("stop_hook_active"):
        reply["decision"] = "block"
        reply["reason"] = (
            "점검(./check)에 실패가 있습니다. 고치고 다시 점검하거나, 고치지 못하면 실패 상태임을 보고에 그대로 적으십시오.\n\n" + output
        )
    print(json.dumps(reply, ensure_ascii=False))
    return 0


